# Copy this file to ".env" in the same folder and fill in your own values.
# ".env" is already in .gitignore — never commit your real secrets.

# --- Database ---------------------------------------------------------
# Default: a local SQLite file, zero setup required.
# For production, use Postgres instead, e.g.:
# DATABASE_URL=postgresql+psycopg2://myuser:mypassword@localhost:5432/satellite_platform
DATABASE_URL=sqlite:///./satellite_platform.db

# --- Auth / JWT ---------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_this_with_a_long_random_string

# --- Admin / scheduler ---------------------------------------------------
# Shared secret between this API and the Java scheduler. Put the SAME
# value here and in java-scheduler/src/main/resources/config.properties
ADMIN_API_KEY=replace_this_with_another_long_random_string

# --- Conjunction screening ---------------------------------------------
CONJUNCTION_THRESHOLD_KM=25

# --- Email alerts (optional — leave SMTP_HOST blank to disable) --------
# Example for Gmail: host=smtp.gmail.com, port=587, and SMTP_PASSWORD
# must be a 16-character Gmail "App Password" (not your normal password) —
# generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@yourdomain.com
